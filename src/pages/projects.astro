---
import fs from "node:fs";
import path from "node:path";
import Book from "../layouts/Book.astro";
import { BOOK, renderMath, tocHtml } from "../lib/book.js";

// Self-contained rendered HTML partial (uses the book's box/algo classes).
const body = renderMath(
  fs.readFileSync(path.join(process.cwd(), "src", "projects.body.html"), "utf8"),
);
---

<Book
  title={`Projects and Competitions · ${BOOK.title}`}
  desc={`Build-it capstones and a final project for ${BOOK.title}, each with a dataset, a metric, and a measured baseline, and each ready to run as a Kaggle community competition.`}
  toc={tocHtml("projects")}
>
  <Fragment set:html={body} />
</Book>
