---
// The shared page chrome: topbar, sidebar TOC, search overlay, KaTeX, fonts.
// All URLs are relative so the site can be served from any prefix.
import { existsSync } from "node:fs";
import { join } from "node:path";

const {
  title,
  desc = "",
  toc,
  onpage = "",
  prevHref = "",
  nextHref = "",
  widgets = [],
} = Astro.props;
const coreWidgets = new Set([
  "kernel-lab", "feature-lift", "gram-heatmap", "rff-converge",
  "svm-margin", "mmd-twosample",
]);
const widgetModules = [...new Set(widgets)]
  .filter((widget) => !coreWidgets.has(widget))
  // Static-first figures may retain data-widget metadata for their fallback
  // shell without having a JavaScript enhancer. Never emit a broken script URL.
  .filter((widget) => existsSync(join(process.cwd(), "public", "assets", `viz-${widget}.js`)))
  .map((widget) => `assets/viz-${widget}.js`);
const hasWidgets = widgets.length > 0;
const author = {
  name: "Taha Bouhsine",
  url: "https://www.tahabouhsine.com",
  affiliation: "AzettaAI",
};
const structuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Book",
  name: "Kernels: The Geometry of Learning",
  alternativeHeadline: "Foundations, Algorithms, and the Frontiers of Machine Intelligence",
  description: "A rigorous, unified account of kernel methods from mathematical foundations to modern machine intelligence.",
  inLanguage: "en",
  isAccessibleForFree: true,
  author: {
    "@type": "Person",
    name: author.name,
    url: author.url,
    affiliation: { "@type": "Organization", name: author.affiliation },
  },
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <meta name="author" content={author.name} />
    <link rel="author" href={author.url} />
    <script type="application/ld+json" set:html={structuredData}></script>
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("bk-theme");
          if (t === "light" || t === "dark") document.documentElement.setAttribute("data-theme", t);
        } catch (e) {}
      })();
    </script>
    <link rel="stylesheet" href="assets/vendor.css" />
    <link rel="stylesheet" href="assets/book.css" />
    <link rel="stylesheet" href="assets/viz.css" />
    <link rel="stylesheet" href="vendor/katex/katex.min.css" />
    <script is:inline defer src="vendor/katex/katex.min.js"></script>
    <script is:inline defer src="vendor/katex/auto-render.min.js"></script>
    <script is:inline defer src="assets/katex-boot.js"></script>
  </head>
  <body data-prev={prevHref} data-next={nextHref}>
    <a class="skip" href="#main">Skip to content</a>
    <div class="gram-progress" id="gram-progress" aria-hidden="true"></div>
    <header class="topbar">
      <button type="button" class="tb-btn" id="menu-btn" aria-label="Open contents" aria-expanded="false">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
      </button>
      <a class="tb-title" href="index.html">Kernels</a>
      <span class="tb-spacer"></span>
      <button type="button" class="tb-btn search-open" aria-label="Search the book">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.8-3.8"></path></svg>
      </button>
      <button type="button" class="tb-btn theme-btn" aria-label="Toggle color theme">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 1 0 0 20V2z"></path><circle cx="12" cy="12" r="9.2" fill="none" stroke="currentColor" stroke-width="1.6"></circle></svg>
      </button>
    </header>
    <div class="book">
      <nav class="toc" id="toc" aria-label="Table of contents">
        <a class="edition-mark" href="index.html" aria-label="Kernels: The Geometry of Learning, home">
          <span class="edition-sigil" aria-hidden="true">
            <i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i>
          </span>
          <span><strong>Kernels</strong><small>The Geometry of Learning</small></span>
        </a>
        <div class="toc-tools">
          <button type="button" class="tool-btn search-open" aria-label="Search the book">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.8-3.8"></path></svg>
            <span>Search</span><kbd>/</kbd>
          </button>
          <button type="button" class="tool-btn theme-btn" aria-label="Toggle color theme">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 1 0 0 20V2z"></path><circle cx="12" cy="12" r="9.2" fill="none" stroke="currentColor" stroke-width="1.6"></circle></svg>
          </button>
        </div>
        <Fragment set:html={toc} />
      </nav>
      <div class="scrim" id="scrim"></div>
      <main id="main">
        <div class="page">
          <slot />
        </div>
        <Fragment set:html={onpage} />
      </main>
    </div>
    <div class="search-overlay" id="search-overlay" hidden>
      <div class="search-box" role="dialog" aria-label="Search the book">
        <input id="search-input" type="search" placeholder="Search the book&hellip;" autocomplete="off" spellcheck="false" />
        <ul class="search-results" id="search-results"></ul>
        <div class="search-hint"><kbd>&uarr;</kbd><kbd>&darr;</kbd> navigate &nbsp; <kbd>Enter</kbd> open &nbsp; <kbd>Esc</kbd> close</div>
      </div>
    </div>
    <button type="button" class="backtop" id="backtop" aria-label="Back to top">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5m-7 7 7-7 7 7"></path></svg>
    </button>
    {widgets.includes("svm-margin") && <script is:inline defer src="assets/smo.js"></script>}
    {hasWidgets && <script is:inline defer src="assets/viz.js"></script>}
    {widgetModules.map((src) => <script is:inline defer src={src}></script>)}
    <script is:inline defer src="assets/nav.js"></script>
  </body>
</html>
